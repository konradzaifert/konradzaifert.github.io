rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /maps/settlement {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == "REPLACE_WITH_OWNER_UID"
        && request.resource.data.keys().hasOnly(['project','version','updatedAt'])
        && request.resource.data.project is string
        && request.resource.data.project.size() <= 950000
        && request.resource.data.version is int
        && request.resource.data.updatedAt == request.time;
    }
  }
}
